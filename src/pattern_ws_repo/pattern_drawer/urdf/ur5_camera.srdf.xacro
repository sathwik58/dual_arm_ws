<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="ur">
  <xacro:include filename="$(find ur_moveit_config)/srdf/ur.srdf.xacro"/>

  <!-- The camera is mounted on the flange: these contacts are expected -->
  <disable_collisions link1="ur5_camera_link" link2="ur5_wrist_3_link" reason="Adjacent"/>
  <disable_collisions link1="ur5_camera_link" link2="ur5_wrist_2_link" reason="Never"/>
  <disable_collisions link1="ur5_camera_link" link2="ur5_wrist_1_link" reason="Never"/>
</robot>