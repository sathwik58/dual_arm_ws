<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="camera" params="prefix parent">
    <xacro:property name="cam_x" value="0.02"/>   
    <xacro:property name="cam_y" value="0.02"/>   
    <xacro:property name="cam_z" value="0.01"/>   
    <xacro:property name="cam_m" value="0.05"/> 
    <link name="ur5_camera_link">
      <visual>
        <geometry><box size="${cam_x} ${cam_y} ${cam_z}"/></geometry>
        <material name="cam_black"><color rgba="0.1 0.1 0.1 1"/></material>
      </visual>
      <collision>
        <geometry><box size="${cam_x} ${cam_y} ${cam_z}"/></geometry>
      </collision>
      <inertial>
        <mass value="${cam_m}"/>
        <inertia ixx="${cam_m/12*(cam_y*cam_y+cam_z*cam_z)}" ixy="0" ixz="0"
                 iyy="${cam_m/12*(cam_x*cam_x+cam_z*cam_z)}" iyz="0"
                 izz="${cam_m/12*(cam_x*cam_x+cam_y*cam_y)}"/>
      </inertial>
    </link>
    <joint name="ur5_camera_joint" type="fixed">
      <parent link="ur5_tool0"/>
      <child link="ur5_camera_link"/>
      <origin xyz="0 0 ${cam_x/2}" rpy="0 -1.5708 0"/>
    </joint>
    <link name="ur5_camera_optical_frame"/>
    <joint name="ur5_camera_optical_joint" type="fixed">
      <parent link="ur5_camera_link"/>
      <child link="ur5_camera_optical_frame"/>
      <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
    </joint>
    <gazebo reference="ur5_camera_link">
      <sensor name="ur5_camera" type="camera">
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
        <topic>ur5/camera/image_raw</topic>
        <ignition_frame_id>ur5_camera_optical_frame</ignition_frame_id>
        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.02</near><far>10</far></clip>
        </camera>
      </sensor>
    </gazebo>
  </xacro:macro>
</robot>